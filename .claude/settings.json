{
    "permissions": {
        "allow": [
            "Skill(investing-dot-com-crawling)",
            "Skill(instagram-contents-publish)",
            "Bash(mv:*)",
            "Bash(rmdir:*)",
            "Bash(mkdir:*)",
            "Bash(find:*)",
            "Bash(git branch:*)",
            "Bash(git switch:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(./gradlew:*)"
        ],
        "deny": []
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    { "type": "command", "command": "bash .claude/hooks/validate-branch-name.sh" },
                    { "type": "command", "command": "bash .claude/hooks/validate-commit-message.sh" }
                ]
            }
        ]
    }
}
